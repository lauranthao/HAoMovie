// HAoMovie's own TMDB Worker. Architecture follows yingxia tmdb-match; names,
// domain and database are our own. Deploy: see README.md in this folder.
// NOTE: database_id below is a placeholder. Create the D1 database first
// (wrangler d1 create hao-tmdb) and put the real id here before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hao-tmdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-28",
  "workers_dev": true,
  "preview_urls": false,
  // Model calls go out from the US (the ModelRelay in src/index.ts serves both providers).
  "durable_objects": { "bindings": [{ "name": "MODEL_RELAY", "class_name": "ModelRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ModelRelay"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "hao-tmdb", "database_id": "REPLACE_WITH_CREATED_DATABASE_ID" }],
  // Per IP address, in memory only. Each viewer opens a title once; a run is a few model turns.
  "ratelimits": [
    { "name": "MATCH_LIMITER", "namespace_id": "4301", "simple": { "limit": 20, "period": 60 } },
    { "name": "DETAILS_LIMITER", "namespace_id": "4302", "simple": { "limit": 60, "period": 60 } },
    { "name": "CATALOG_SEARCH_LIMITER", "namespace_id": "4303", "simple": { "limit": 120, "period": 60 } }
  ],
  // Secrets: OPENAI_API_KEY, GEMINI_API_KEY (retained for switching back), TMDB_TOKEN (wrangler secret put).
  "vars": { "AI_PROVIDER": "openai", "OPENAI_MODEL": "gpt-4o-mini", "GEMINI_MODEL": "gemini-2.0-flash", "DAILY_RUNS": "2000" },
  // Daily: drop expired answers.
  "triggers": { "crons": ["23 3 * * *"] },
  "observability": { "enabled": false }
}
